.head { margin: 0 8rpx 8rpx; }
.warn { margin-top: 12rpx; font-size: 24rpx; color: #92400e; background: #fef6e1; padding: 10rpx 18rpx; border-radius: 10rpx; }
.stage { font-weight: 600; color: var(--accent); margin: 28rpx 8rpx 14rpx; }
.row { display: flex; align-items: flex-start; }
.check {
  flex: none; width: 44rpx; height: 44rpx; margin: 4rpx 22rpx 0 0;
  border: 3rpx solid #d4d4d0; border-radius: 50%;
  text-align: center; line-height: 40rpx; color: #fff; font-size: 26rpx;
}
.is-done .check { background: var(--accent); border-color: var(--accent); }
.is-done .title { color: #a3a3a3; text-decoration: line-through; }
.body { flex: 1; }
.title { font-weight: 600; margin-bottom: 6rpx; }
.plain {
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
  overflow: hidden; margin-bottom: 10rpx;
}
.actions { margin-top: 32rpx; text-align: center; }
.share-btn { background: var(--accent); color: #fff; border-radius: 44rpx; font-size: 30rpx; }
.reset { margin-top: 20rpx; }
