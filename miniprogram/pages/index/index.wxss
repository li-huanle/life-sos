.search-bar {
  background: #fff; border-radius: 40rpx; padding: 18rpx 32rpx;
  color: #a3a3a3; font-size: 28rpx; margin-bottom: 24rpx;
}
.hint { margin: 0 8rpx 16rpx; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.scene { width: calc(50% - 10rpx); box-sizing: border-box; min-height: 210rpx; }
.icon { font-size: 48rpx; }
.title { font-weight: 600; font-size: 32rpx; margin: 8rpx 0 4rpx; }
.progress { margin-top: 8rpx; font-size: 22rpx; color: var(--accent); }
