.search-bar {
  background: #fff; border-radius: 40rpx; padding: 18rpx 32rpx;
  color: #a3a3a3; font-size: 28rpx; margin-bottom: 24rpx;
}
.switch {
  display: flex; background: #ebebe8; border-radius: 16rpx; padding: 6rpx; margin-bottom: 8rpx;
}
.seg {
  flex: 1; text-align: center; font-size: 28rpx; line-height: 64rpx;
  border-radius: 12rpx; color: var(--muted);
}
.seg.on { background: #fff; color: var(--text); font-weight: 600; }
.group-head { margin: 32rpx 8rpx 16rpx; }
.group-title { font-weight: 700; font-size: 32rpx; margin-right: 16rpx; }
.group-desc { font-size: 24rpx; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.scene { width: calc(50% - 10rpx); box-sizing: border-box; min-height: 210rpx; }
.icon { font-size: 48rpx; }
.title { font-weight: 600; font-size: 32rpx; margin: 8rpx 0 4rpx; }
.progress { margin-top: 8rpx; font-size: 22rpx; color: var(--accent); }
