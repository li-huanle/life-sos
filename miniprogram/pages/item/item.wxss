.container { padding-bottom: 160rpx; }
.title { font-size: 36rpx; font-weight: 700; line-height: 1.45; margin-bottom: 16rpx; }
.label { font-size: 24rpx; color: var(--accent); font-weight: 600; margin-bottom: 8rpx; }
.source { font-size: 22rpx; color: #2563eb; word-break: break-all; margin-top: 10rpx; }
.bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; background: #fff; border-top: 1rpx solid var(--line);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}
.bar-btn {
  flex: 1; margin: 0 10rpx; text-align: center; font-size: 28rpx;
  line-height: 76rpx; border-radius: 40rpx; background: #f1f1ee; padding: 0;
}
.bar-btn.primary { background: var(--accent); color: #fff; }
